{
  "manifest_version": 3,
  "name": "WhatsApp Translator",
  "version": "0.1.0",
  "description": "Translate WhatsApp messages into natural English.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}